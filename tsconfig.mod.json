{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "alwaysStrict": false,
    "useDefineForClassFields": false,
    "erasableSyntaxOnly": true,
    "noEmitOnError": true,
    "skipLibCheck": false,
    "newLine": "lf"
  },
  "include": ["mod/*.ts", "resource-override/loader.ts"]
}
