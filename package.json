{
  "name": "devast-io-recovery",
  "private": true,
  "version": "0.1.0",
  "description": "Recovery of the user-supplied historical modified client",
  "scripts": {
    "build": "node tools/build_client.cjs",
    "check": "node tools/check_client.cjs",
    "test": "python3 -m unittest discover -s tests -v && npm run check && node --test tests/*.test.cjs",
    "update:once": "python3 tools/update_client.py once",
    "update:watch": "python3 tools/update_client.py watch",
    "update:source": "python3 tools/update_client.py source",
    "update:watch-source": "python3 tools/update_client.py watch-source",
    "update:official": "python3 tools/update_client.py official",
    "update:watch-official": "python3 tools/update_client.py watch-official",
    "update:status": "python3 tools/update_client.py status",
    "update:serve": "python3 tools/update_client.py serve",
    "update:rollback": "python3 tools/update_client.py rollback",
    "build:readable": "npm run build && node tools/format_readable.cjs",
    "build:mod": "node tools/compile_mod.cjs",
    "typecheck": "node tools/compile_mod.cjs --check",
    "check:generated": "node tools/compile_mod.cjs --verify",
    "build:published-mod": "node tools/build_published_mod.cjs",
    "check:published-mod": "node tools/build_published_mod.cjs --check",
    "build:verified-mod": "node tools/build_verified_mod.cjs",
    "build:video-aim": "node tools/build_video_aim.cjs",
    "build:rust": "node tools/build_rust.cjs",
    "build:rust-client": "node tools/build_rust_client.cjs",
    "test:rust": "node tools/test_rust.cjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "js-beautify": "1.15.4",
    "playwright-core": "1.62.1",
    "typescript": "5.9.3"
  }
}
